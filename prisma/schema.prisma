generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                    @id @default(uuid())
  externalId         String?                   @unique
  email              String                    @unique
  name               String?
  role               Role                      @relation(fields: [roleId], references: [id])
  roleId             Int
  department         Department?               @relation(fields: [departmentId], references: [id])
  departmentId       Int?
  assignments        Assignment[]              @relation("AssignmentUser")
  assignedAssignments Assignment[]             @relation("AssignedBy")
  progress           Progress[]
  certifications     CertificationAssignment[] @relation("CertificationUser")
  issuedCertifications CertificationAssignment[] @relation("CertificationIssuer")
  createdPaths       LearningPath[]            @relation("LearningPathCreator")
  createdArticles    KBArticle[]               @relation("KBArticleCreator")
  auditLogs          AuditLog[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Role {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users User[]
}

model Department {
  id         Int            @id @default(autoincrement())
  name       String         @unique
  users      User[]
  paths      LearningPath[]
  kbArticles KBArticle[]
}

model LearningPath {
  id           String      @id @default(uuid())
  title        String
  description  String?
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId Int?
  modules      Module[]
  assignments  Assignment[]
  published    Boolean     @default(false)
  createdById  String?
  createdBy    User?       @relation("LearningPathCreator", fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Module {
  id            String       @id @default(uuid())
  title         String
  order         Int
  learningPath  LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  learningPathId String
  lessons       Lesson[]
}

model Lesson {
  id        String     @id @default(uuid())
  title     String
  order     Int
  type      LessonType
  content   Json?
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId  String
  duration  Int?
  progress  Progress[]
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
  CHECKLIST
  ASSIGNMENT
}

model Assignment {
  id            String           @id @default(uuid())
  user          User             @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  learningPath  LearningPath     @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  learningPathId String
  assignedById  String?
  assignedBy    User?            @relation("AssignedBy", fields: [assignedById], references: [id])
  dueDate       DateTime?
  status        AssignmentStatus @default(NOT_STARTED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, learningPathId])
  @@index([userId, status])
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model Progress {
  id          String         @id @default(uuid())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  status      ProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  evidence    String?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, status])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model KBArticle {
  id           String       @id @default(uuid())
  title        String
  content      String
  summary      String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  departmentId Int?
  tags         String[]     @default([])
  attachments  Attachment[]
  createdById  String?
  createdBy    User?        @relation("KBArticleCreator", fields: [createdById], references: [id])
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Attachment {
  id        String     @id @default(uuid())
  filename  String
  url       String
  size      Int?
  mimeType  String?
  createdAt DateTime   @default(now())
  article   KBArticle? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String?
}

model Certification {
  id           String                    @id @default(uuid())
  name         String
  description  String?
  validityDays Int?
  createdAt    DateTime                  @default(now())
  assignments  CertificationAssignment[]
}

model CertificationAssignment {
  id              String         @id @default(uuid())
  user            User           @relation("CertificationUser", fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  certification   Certification  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  certificationId String
  issuedAt        DateTime       @default(now())
  expiresAt       DateTime?
  issuedById      String?
  issuedBy        User?          @relation("CertificationIssuer", fields: [issuedById], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
